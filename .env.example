# --- Required: Showdown account ---
DOWN_USERNAME=your_showdown_username
DOWN_PASSWORD=your_showdown_password

# --- Match mode: search | challenge | accept ---
DOWN_MATCH_MODE=challenge
# Required when DOWN_MATCH_MODE is challenge or accept
DOWN_TARGET_USERNAME=opponent_username

# --- Showdown connection ---
DOWN_SHOWDOWN_WS_URL=wss://sim3.psim.us/showdown/websocket
DOWN_SHOWDOWN_LOGIN_URL=https://play.pokemonshowdown.com/api/login
DOWN_FORMAT=gen91v1
DOWN_ROOM_WAIT_TIMEOUT_MS=180000

# --- Team config ---
# Option A: leave empty to use built-in default team from src/team.js
# DOWN_TEAM_EXPORT=

# Option B: provide packed team directly (overrides DOWN_TEAM_EXPORT)
# DOWN_PACKED_TEAM=

# --- LLM config ---
DOWN_LLM_PROVIDER=
DOWN_LLM_MODEL=
DOWN_LLM_REASONING_EFFORT=medium
DOWN_LLM_TIMEOUT_MS=20000

# Codex auth is read from: ~/.codex/auth.json
# Optional endpoint override (default is ChatGPT backend)
DOWN_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex

# Optional fallback provider settings (only if DOWN_LLM_PROVIDER=openai)
# DOWN_OPENAI_API_KEY=
# DOWN_OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
